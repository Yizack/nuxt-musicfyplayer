{
  "name": "nuxt-musicfyplayer",
  "version": "2.1.10",
  "description": "Embed a simple and beautiful HTML music player from local or hosted audio on your website using MediaElement.js and fast-average-color",
  "keywords": [
    "nuxt",
    "nuxt3",
    "music-player",
    "music"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yizack/nuxt-musicfyplayer.git"
  },
  "homepage": "https://github.com/Yizack/nuxt-musicfyplayer",
  "author": {
    "name": "Yizack Rangel",
    "email": "yizackr@gmail.com",
    "url": "https://yizack.com"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "node --run build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "node --run lint && node --run build && node --run test && changelogen --release --push --no-github",
    "release:github": "changelogen gh release",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Error: no test specified\"",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc -b --noEmit",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "fast-average-color": "^9.6.0",
    "mediaelement": "^7.1.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^25.0.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "nuxt": "^4.5.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.4.2"
}
